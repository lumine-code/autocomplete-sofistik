{
  "name": "autocomplete-sofistik",
  "author": "lumine-code",
  "description": "Autocompletion for SOFiSTiK modules, commands, and parameters.",
  "repository": "https://github.com/lumine-code/autocomplete-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-sofistik/issues"
  },
  "keywords": [
    "cadinp",
    "structural",
    "fem",
    "completion",
    "finite-element"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "lib",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "consumedServices": {
    "sofistik.keywords": {
      "versions": {
        "^1.0.0": "consumeSofistikKeywords"
      }
    },
    "sofistik.environment": {
      "versions": {
        "^1.0.0": "consumeSofistikEnvironment"
      }
    }
  },
  "configSchema": {
    "textCase": {
      "title": "Suggestions case",
      "description": "Convert case for suggestion elements.",
      "type": "boolean",
      "enum": [
        {
          "value": true,
          "description": "Uppercase"
        },
        {
          "value": false,
          "description": "Lowercase"
        }
      ],
      "default": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
