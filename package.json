{
  "name": "autocomplete-sofistik",
  "author": "lumine-code",
  "description": "Get hints as you type the SOFiSTiK input",
  "repository": "https://github.com/lumine-code/autocomplete-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-sofistik/issues"
  },
  "keywords": [
    "autocomplete",
    "sofistik"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../autocomplete-sofistik/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "getProvider"
      }
    }
  },
  "consumedServices": {
    "sofistik.keywords": {
      "versions": {
        "^1.0.0": "consumeKeywordsService"
      }
    }
  },
  "configSchema": {
    "textCase": {
      "title": "Suggestions case",
      "description": "Convert case for suggestion elements.",
      "type": "boolean",
      "enum": [
        {
          "value": true,
          "description": "Uppercase"
        },
        {
          "value": false,
          "description": "Lowercase"
        }
      ],
      "default": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
